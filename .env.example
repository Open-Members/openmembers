# The local runner injects these values automatically: npm run dev:local.
# For an independently configured installation, copy this template to .env.local.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Optional additional trusted origins, comma-separated; never include paths.
AUTH_ALLOWED_ORIGINS=
# Optional OAuth providers: google,apple. Empty disables OAuth actions.
# Provider credentials/callbacks must also be configured in this installation's Supabase.
OAUTH_PROVIDERS=
# Optional JSON presentation settings; defaults to ./openmembers.config.json when present.
# This file contains public branding/content only, never provider credentials.
OPENMEMBERS_CONFIG_FILE=
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:55431
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Optional server-only route to the same Supabase installation when its public
# origin is not reachable from the app container. Never prefix this with NEXT_PUBLIC_.
SUPABASE_INTERNAL_URL=
# Optional server-only route to this app for self-hosted asset reads.
OPENMEMBERS_INTERNAL_URL=
DATABASE_URL=
DATABASE_POOL_URL=
# Optional HTTPS origins for certificate logo/signature images outside the
# configured application and Supabase origins. Comma-separated, without paths.
CERTIFICATE_IMAGE_ALLOWED_ORIGINS=

# Optional email: empty/resend uses Resend only when configured; mailpit captures locally.
# npm run dev:local forces Mailpit and removes external provider credentials.
EMAIL_TRANSPORT=
MAILPIT_URL=
RESEND_API_KEY=
RESEND_SENDER_EMAIL=
RESEND_SENDER_NAME=Open Members
RESEND_WEBHOOK_SECRET=
SEND_EMAIL_HOOK_SECRET=
SUPPORT_INBOX_EMAIL=
MEMBERSHIP_COMMUNITY_URL=
MEMBERSHIP_HELP_URL=

# Optional payments. Use only your own sandbox/test credentials.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Price/product-to-access mappings and Guru/generic tokens are configured in Admin.

# Optional video storage.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=

# Scheduled operations are not enabled by this template.
CRON_SECRET=

# Optional AI: opt in only after preparing an authorized lesson_chunks corpus.
COURSE_CHAT_ENABLED=false
AI_GATEWAY_API_KEY=
# Optional browser telemetry. No built-in account identifiers.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
NEXT_PUBLIC_GA4_MEASUREMENT_ID=
NEXT_PUBLIC_META_PIXEL_ID=

# Push subscriptions are disabled until a worker and delivery pipeline exist.
LOG_LEVEL=warn
