# Copy outside the checkout to /etc/openmembers/application.env (mode 0600).
# This file is read by Compose; do not source it in a shell.
OPENMEMBERS_ENV_FILE=/etc/openmembers/application.env
OPENMEMBERS_CONFIG_PATH=/etc/openmembers/installation.json
OPENMEMBERS_IMAGE=openmembers:pilot
OPENMEMBERS_PORT=3000

# Public values: used at build AND runtime. Rebuild after changing them.
NEXT_PUBLIC_SITE_URL=https://members.example.org
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Private runtime values: use only this new installation's credentials.
SUPABASE_SERVICE_ROLE_KEY=
# Optional server-only origin for container-to-Supabase traffic.
SUPABASE_INTERNAL_URL=
# Optional server-only origin for application self-requests in a container.
OPENMEMBERS_INTERNAL_URL=
CRON_SECRET=
AUTH_ALLOWED_ORIGINS=
CERTIFICATE_IMAGE_ALLOWED_ORIGINS=
OAUTH_PROVIDERS=
COURSE_CHAT_ENABLED=false

# Optional. The expiration-warning job requires a working mail transport.
# See .env.example and docs/integrations/README.md for other optional providers.
EMAIL_TRANSPORT=
RESEND_API_KEY=
RESEND_SENDER_EMAIL=
RESEND_SENDER_NAME=
SEND_EMAIL_HOOK_SECRET=
RESEND_WEBHOOK_SECRET=
LOG_LEVEL=warn
